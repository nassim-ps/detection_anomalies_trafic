# Copier en .env et remplacer les valeurs.
POSTGRES_PASSWORD=change-me
UMAMI_APP_SECRET=change-me-long-random-string
ML_READER_PASSWORD=change-me
ML_WRITER_PASSWORD=change-me

# Depuis l'hôte : localhost ; depuis un conteneur : postgres / umami
PG_DSN_READER=postgresql://ml_reader:change-me@localhost:5432/umami
PG_DSN_WRITER=postgresql://ml_writer:change-me@localhost:5432/umami
UMAMI_URL=http://localhost:3000
UMAMI_WEBSITE_ID=
